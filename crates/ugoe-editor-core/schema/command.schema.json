{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command",
  "description": "エディタの編集操作。`op` で種類を選ぶ。1 コマンドが Undo の 1 単位で、対象は ID で指定する。",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "add_parameter"
        },
        "parameter": {
          "$ref": "#/$defs/Parameter"
        }
      },
      "required": [
        "op",
        "parameter"
      ]
    },
    {
      "description": "パラメータを削除する。このパラメータを軸に持つキーフォーム格子は、その軸を\n既定値のキー (なければ最も近いキー) の断面に畳む。ミラーとエフェクトの参照も外す。",
      "type": "object",
      "properties": {
        "id": {
          "description": "要素の ID。新しい要素には `[A-Za-z0-9_]+` の形式を使う。",
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "remove_parameter"
        }
      },
      "required": [
        "op",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "default": {
          "type": "number",
          "format": "float"
        },
        "id": {
          "description": "要素の ID。新しい要素には `[A-Za-z0-9_]+` の形式を使う。",
          "type": "string"
        },
        "max": {
          "type": "number",
          "format": "float"
        },
        "min": {
          "type": "number",
          "format": "float"
        },
        "op": {
          "type": "string",
          "const": "set_parameter_range"
        }
      },
      "required": [
        "op",
        "id",
        "min",
        "default",
        "max"
      ]
    },
    {
      "description": "複数コマンドを 1 つの Undo 単位にまとめる (AI の一括提案など)。",
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        },
        "label": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "batch"
        }
      },
      "required": [
        "op",
        "label",
        "commands"
      ]
    },
    {
      "description": "パラメータの表示名を変える (ID は変えない)。",
