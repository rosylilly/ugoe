{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ugoe-viewer",
  "version": "0.0.0",
  "identifier": "app.ugoe.viewer",
  "build": {
    "beforeDevCommand": "pnpm wasm && pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm wasm && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ugoe viewer",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost 'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": ["ugoe"],
        "name": "ugoe model",
        "description": "ugoe model",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-ugoe",
        "exportedType": {
          "identifier": "app.ugoe.model",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["ugoemod"],
        "name": "ugoe module",
        "description": "ugoe dress-up module",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-ugoe-module",
        "exportedType": {
          "identifier": "app.ugoe.module",
          "conformsTo": ["public.data"]
        }
      }
    ]
  }
}
