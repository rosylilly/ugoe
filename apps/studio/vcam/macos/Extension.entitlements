<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Camera Extension の entitlement (docs/release.md#macos-の仮想カメラ)。Camera Extension はサンドボックスの中で動く決まり。
  アプリグループは Info.plist の CMIOExtensionMachServiceName と同じ名前にする。${TEAM_ID} はビルドのスクリプトが埋める。
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>${TEAM_ID}.app.ugoe.studio.camera</string>
  </array>
</dict>
</plist>
