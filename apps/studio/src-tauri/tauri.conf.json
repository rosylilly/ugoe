{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ugoe-studio",
  "version": "0.0.0",
  "identifier": "app.ugoe.studio",
  "build": {
    "beforeDevCommand": "pnpm wasm && pnpm dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "pnpm wasm && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ugoe studio",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "output",
        "create": false,
        "title": "ugoe studio output",
        "url": "output.html",
        "width": 960,
        "height": 540,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost 'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
