<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  仮想カメラ (Camera Extension) を入れたスタジオの entitlement (tauri.macos-vcam.conf.json、docs/release.md#macos-の仮想カメラ)。
  Entitlements.plist に、System Extension を入れる権限を足したもの。この権限はプロビジョニングプロファイルが要るので、
  Apple Developer のアカウントを用意するまでの配布物 (Entitlements.plist) には入れない (ADR 0028 の 8.)。
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.developer.system-extension.install</key>
  <true/>
</dict>
</plist>
