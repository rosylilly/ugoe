{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "control",
  "description": "操作ウィンドウの権限 (OS の言語を読む。ファイルのダイアログはバックエンドが開く (open_file_dialog・save_file_dialog、T0838)。アプリのコマンドは出力ウィンドウだけのもの (src/acl.rs の OUTPUT_COMMANDS) を除いてすべて)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "os:allow-locale",
    "allow-restore-profile",
    "allow-new-profile",
    "allow-open-profile",
    "allow-save-profile",
    "allow-forget-recent-profile",
    "allow-add-scene",
    "allow-duplicate-scene",
    "allow-move-scene",
    "allow-remove-scene",
    "allow-update-scene",
    "allow-activate-scene",
    "allow-show-pose",
    "allow-set-output-preset",
    "allow-subscribe-status",
    "allow-set-parameter",
    "allow-reset-parameters",
    "allow-output-state",
    "allow-set-output-visible",
    "allow-set-output-on-top",
    "allow-set-output-size",
    "allow-tick-rate",
    "allow-set-tick-rate",
    "allow-gpu-settings",
    "allow-set-gpu-preference",
    "allow-open-graphics-settings",
    "allow-subscribe-pulse",
    "allow-set-tracking",
    "allow-set-tracking-paused",
    "allow-set-auto-eye-blink",
    "allow-set-lip-sync-level",
    "allow-set-lip-sync-paused",
    "allow-play-motion",
    "allow-stop-motions",
    "allow-set-expression",
    "allow-add-expression",
    "allow-remove-expression",
    "allow-clear-expressions",
    "allow-set-motion-settings",
    "allow-set-input-settings",
    "allow-set-hotkeys",
    "allow-suspend-hotkeys",
    "allow-module-slot",
    "allow-open-file-dialog",
    "allow-save-file-dialog",
    "allow-virtual-camera-state",
    "allow-start-virtual-camera",
    "allow-stop-virtual-camera",
    "allow-set-virtual-camera-settings",
    "allow-api-state",
    "allow-set-api-enabled",
    "allow-set-api-port",
    "allow-api-token",
    "allow-regenerate-api-token",
    "allow-approve-api-client",
    "allow-deny-api-client",
    "allow-revoke-api-client",
    "allow-disconnect-api-client",
    "allow-set-source-enabled",
    "allow-source-url",
    "allow-regenerate-source-token"
  ]
}
