{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限 (OS の言語を読む os:allow-locale を含む。アプリのコマンドは src/acl.rs の COMMANDS をすべて。T0686)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "os:allow-locale",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/rosylilly/ugoe/*"
        },
        {
          "url": "https://www.anthropic.com/legal/*"
        }
      ]
    },
    "allow-app-info",
    "allow-apply-command",
    "allow-get-model-json",
    "allow-get-animations",
    "allow-get-physics",
    "allow-undo",
    "allow-redo",
    "allow-project-status",
    "allow-new-project",
    "allow-new-project-from-psd",
    "allow-open-project",
    "allow-open-sample-project",
    "allow-reload-project",
    "allow-check-external-change",
    "allow-save-project",
    "allow-save-project-as",
    "allow-get-export-settings",
    "allow-set-export-settings",
    "allow-get-preview-lighting",
    "allow-set-preview-lighting",
    "allow-export-bundle",
    "allow-get-model-bundle",
    "allow-module-status",
    "allow-read-module-base",
    "allow-new-module-project",
    "allow-open-module-with-base",
    "allow-export-module",
    "allow-module-open-problem",
    "allow-check-base-change",
    "allow-reload-base",
    "allow-get-preview-base-bundle",
    "allow-get-preview-module",
    "allow-compare-preview-module",
    "allow-import-psd",
    "allow-local-to-canvas",
    "allow-canvas-to-local",
    "allow-find-overflows",
    "allow-verify-overflows",
    "allow-check-physics",
    "allow-check-avatar-profile",
    "allow-ai-settings",
    "allow-set-ai-provider",
    "allow-store-api-key",
    "allow-delete-api-key",
    "allow-set-ai-send-externally",
    "allow-forget-ai-consent",
    "allow-test-ai-connection",
    "allow-get-proposals",
    "allow-classify-psd-layers",
    "allow-propose-rig-from-psd",
    "allow-regenerate-rig-proposal",
    "allow-propose-normal-maps",
    "allow-preview-proposal",
    "allow-get-proposal-preview-bundle",
    "allow-clear-proposal-preview",
    "allow-adopt-proposal",
    "allow-reject-proposal",
    "allow-dismiss-stale-rigs",
    "allow-mcp-bridge-status",
    "allow-set-mcp-bridge-enabled",
    "allow-set-mcp-bridge-port",
    "allow-regenerate-mcp-bridge-token",
    "allow-get-mcp-bridge-token",
    "allow-answer-mcp-approval",
    "allow-open-claude-desktop-bundle",
    "allow-save-claude-desktop-bundle",
    "allow-write-json-file",
    "allow-write-png-file",
    "allow-get-preview-modules",
    "allow-set-preview-modules",
    "allow-read-module-file",
    "allow-get-normal-map-group",
    "allow-get-normal-map-groups",
    "allow-generate-texture-normal-map",
    "allow-assign-texture-normal-map",
    "allow-get-texture-png"
  ]
}
