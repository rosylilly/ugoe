; ugoe の GDExtension (bindings/godot)。ライブラリは `node bindings/godot/build.mjs` が bin/ に置く。
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libugoe_godot.so"
linux.release.x86_64 = "res://bin/libugoe_godot.so"
linux.debug.arm64 = "res://bin/libugoe_godot.so"
linux.release.arm64 = "res://bin/libugoe_godot.so"
windows.debug.x86_64 = "res://bin/ugoe_godot.dll"
windows.release.x86_64 = "res://bin/ugoe_godot.dll"
macos.debug = "res://bin/libugoe_godot.dylib"
macos.release = "res://bin/libugoe_godot.dylib"
