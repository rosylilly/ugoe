  "hotkeys": [
    {
      "keys": "Ctrl+Shift+Digit1",
      "action": {
        "kind": "scene",
        "scene": "chat"
      }
    },
    {
      "keys": "Ctrl+Shift+Digit2",
      "action": {
        "kind": "scene",
        "scene": "evening"
      }
    },
    {
      "keys": "Ctrl+Shift+Digit3",
      "action": {
        "kind": "scene",
        "scene": "dress-up"
      }
    },
    {
      "keys": "Ctrl+Shift+Digit4",
      "action": {
        "kind": "scene",
        "scene": "corner"
      }
    },
    {
      "keys": "Ctrl+Alt+Digit1",
      "action": {
        "kind": "expression",
        "expression": "smile",
        "mode": "toggle"
      }
    },
    {
      "keys": "Ctrl+Alt+Digit2",
      "action": {
        "kind": "expression",
        "expression": "surprised",
        "mode": "toggle"
      }
    },
    {
      "keys": "Ctrl+Alt+Digit0",
      "action": {
        "kind": "clearExpressions"
      }
    },
    {
      "keys": "Ctrl+Alt+KeyN",
      "action": {
        "kind": "motion",
        "motion": "nod",
        "priority": "normal"
      }
    },
    {
      "keys": "Ctrl+Alt+KeyM",
      "action": {
        "kind": "motion",
        "motion": "shake",
        "priority": "normal"
      }
    },
    {
      "keys": "Ctrl+Alt+KeyH",
      "action": {
        "kind": "dressUp",
        "slot": "Hair",
        "module": "dress-up/twin-tails.ugoemod"
      }
    },
    {
      "keys": "Ctrl+Alt+KeyC",
      "action": {
        "kind": "dressUp",
        "slot": "Headwear",
        "module": "dress-up/cat-ears.ugoemod"
      }
    },
    {
      "keys": "Ctrl+Alt+KeyW",
      "action": {
        "kind": "pose",
        "part": "Wave"
      }
    },
    {
      "keys": "Ctrl+Alt+KeyD",
      "action": {
        "kind": "pose",
        "part": "HandsDown"
      }
    },
    {
      "keys": "Ctrl+Alt+KeyP",
      "action": {
        "kind": "trackingPause"
      }
    },
    {
      "keys": "Ctrl+Alt+KeyK",
      "action": {
        "kind": "trackingCalibrate"
      }
    },
    {
      "keys": "Ctrl+Alt+KeyL",
      "action": {
        "kind": "lipSyncPause"
      }
    }
  ]
}
