    "CommercialUsage": {
      "oneOf": [
        {
          "type": "string",
          "const": "personal_non_profit"
        },
        {
          "type": "string",
          "const": "personal_profit"
        },
        {
          "type": "string",
          "const": "corporation"
        }
      ]
    },
    "CreditNotation": {
      "oneOf": [
        {
          "type": "string",
          "const": "required"
        },
        {
          "type": "string",
          "const": "unnecessary"
        }
      ]
    },
    "Deformer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DeformerKind"
