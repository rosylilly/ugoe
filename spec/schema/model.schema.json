        "yaw": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pivot"
      ]
    },
    "DrawOrderRange": {
      "type": "object",
      "properties": {
        "max": {
          "type": "number",
          "format": "float"
        },
        "min": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "Effects": {
      "type": "object",
      "properties": {
        "breath": {
          "$ref": "#/$defs/Breath",
          "default": {
            "parameters": []
