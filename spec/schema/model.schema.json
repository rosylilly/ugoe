          }
        }
      }
    },
    "LookAt": {
      "type": "object",
      "properties": {
        "range_x": {
          "type": "number",
          "format": "float",
          "default": 30.0
        },
        "range_y": {
          "type": "number",
          "format": "float",
          "default": 30.0
        },
        "x": {
          "type": "string",
          "default": "EyeBallX"
        },
        "y": {
          "type": "string",
          "default": "EyeBallY"
        }
      }
    },
    "MaskMode": {
      "oneOf": [
        {
          "type": "string",
          "const": "union"
        },
        {
