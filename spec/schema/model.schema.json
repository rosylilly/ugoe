        "offset": {
          "type": "number",
          "format": "float"
        },
        "parameter": {
          "type": "string"
        },
        "peak": {
          "type": "number",
          "format": "float"
        },
        "weight": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "parameter",
        "offset",
        "peak",
        "cycle",
        "weight"
      ]
