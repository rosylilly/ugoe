            }
          ]
        },
        "interpolation": {
          "$ref": "#/$defs/KeyformInterpolation"
        },
        "keyforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WarpKeyform"
          }
        },
        "mirror_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/MirrorSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyformOrigin"
          }
        }
      },
      "required": [
        "keyforms"
      ]
