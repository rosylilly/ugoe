        "mirror": {
          "type": [
            "string",
            "null"
          ]
        },
        "mirror_axis": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "part": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "part",
        "kind"
      ]
    },
    "DeformerKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "warp"
            }
          },
          "$ref": "#/$defs/WarpDeformer",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rotation"
            }
          },
          "$ref": "#/$defs/RotationDeformer",
          "required": [
            "type"
          ]
        }
      ]
    },
    "DepthRotation": {
      "type": "object",
      "properties": {
        "angle_scale": {
          "type": "number",
          "format": "float",
          "default": 1.0
