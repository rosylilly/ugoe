    "KeyformInference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "additive"
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "depth_rotation"
            }
          },
          "$ref": "#/$defs/DepthRotation",
          "required": [
            "method"
          ]
        }
      ]
    },
    "KeyformInterpolation": {
      "oneOf": [
        {
          "type": "string",
          "const": "linear"
        },
        {
          "type": "string",
          "const": "smooth"
        }
      ]
    },
    "KeyformOrigin": {
      "oneOf": [
        {
          "type": "string",
          "const": "authored"
        },
        {
          "type": "string",
          "const": "derived"
