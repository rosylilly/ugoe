      ]
    },
    "GluePair": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "b": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "weight": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "a",
        "b",
        "weight"
      ]
    },
    "HitArea": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "mesh": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "mesh"
      ]
    },
    "KeyformBinding": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          }
        },
        "parameter": {
          "type": "string"
        }
      },
      "required": [
        "parameter",
        "keys"
      ]
    },
    "KeyformGrid": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/KeyformBinding"
          }
        },
        "blend_shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyformGrid"
          }
        },
        "inference": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyformInference"
            },
            {
              "type": "null"
            }
          ]
        },
        "interpolation": {
          "$ref": "#/$defs/KeyformInterpolation"
        },
        "keyforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartKeyform"
          }
        },
        "mirror_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/MirrorSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyformOrigin"
          }
        }
      },
      "required": [
        "keyforms"
      ]
    },
    "KeyformGrid2": {
      "type": "object",
