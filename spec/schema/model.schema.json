        },
        "eye_blink": {
          "$ref": "#/$defs/EyeBlink",
          "default": {
            "closed": 0.05,
            "closing": 0.1,
            "interval": 4.0,
            "opening": 0.15,
            "parameters": [],
            "seed": 0
          }
        },
        "lip_sync": {
          "$ref": "#/$defs/LipSync",
          "default": {
            "parameters": []
          }
        }
      }
    },
    "EyeBlink": {
      "type": "object",
      "properties": {
        "closed": {
          "type": "number",
          "format": "float",
          "default": 0.05
