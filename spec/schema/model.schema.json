    "KeyformGrid3": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/KeyformBinding"
          }
        },
        "blend_shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyformGrid3"
          }
        },
        "inference": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyformInference"
            },
            {
              "type": "null"
            }
          ]
        },
        "interpolation": {
          "$ref": "#/$defs/KeyformInterpolation"
        },
        "keyforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RotationKeyform"
          }
        },
        "mirror_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/MirrorSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyformOrigin"
          }
        }
      },
      "required": [
        "keyforms"
