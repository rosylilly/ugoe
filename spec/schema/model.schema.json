        "closing": {
          "type": "number",
          "format": "float",
          "default": 0.1
        },
        "interval": {
          "type": "number",
          "format": "float",
          "default": 4.0
        },
        "opening": {
          "type": "number",
          "format": "float",
          "default": 0.15
        },
        "parameters": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        }
      }
    },
    "Glue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "keyforms": {
          "$ref": "#/$defs/KeyformGrid5"
        },
        "mesh_a": {
          "type": "string"
        },
        "mesh_b": {
          "type": "string"
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GluePair"
          }
        }
      },
      "required": [
        "id",
        "mesh_a",
        "mesh_b",
        "pairs",
        "keyforms"
      ]
    },
    "GlueKeyform": {
      "type": "object",
      "properties": {
        "intensity": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
