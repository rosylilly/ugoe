{
  "$id": "https://raw.githubusercontent.com/rosylilly/ugoe/main/spec/schema/model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ugoe Model (Specification 0.1 Draft)",
  "type": "object",
  "properties": {
    "avatar": {
      "anyOf": [
        {
          "$ref": "#/$defs/AvatarProfile"
        },
        {
          "type": "null"
        }
      ]
    },
    "deformers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Deformer"
      }
    },
    "effects": {
      "$ref": "#/$defs/Effects",
      "default": {
        "breath": {
          "parameters": []
        },
        "eye_blink": {
          "closed": 0.05,
          "closing": 0.1,
          "interval": 4.0,
          "opening": 0.15,
          "parameters": [],
          "seed": 0
        },
        "lip_sync": {
          "parameters": []
        }
      }
    },
    "glues": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Glue"
      }
    },
    "hit_areas": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/HitArea"
      }
    },
    "lighting": {
      "type": "boolean"
    },
    "meshes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Mesh"
      }
    },
    "meta": {
      "$ref": "#/$defs/ModelMeta"
    },
    "parameter_groups": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ParameterGroup"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Parameter"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Part"
      }
    },
    "pose": {
      "$ref": "#/$defs/Pose",
      "default": {
        "fade_duration": 0.5,
        "groups": []
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "const": 0,
      "minimum": 0
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Slot"
      }
    },
    "textures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TextureRef"
      }
    }
  },
  "$comment": "Part of the ugoe Specification 0.1 (Draft), Copyright (c) 2026 Sho KUSANO and the ugoe contributors, licensed under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/). Generated from the reference implementation; see spec/schema/README.md.",
  "required": [
    "schema_version",
    "meta",
    "parameters",
    "parts",
    "meshes",
    "textures"
  ],
  "$defs": {
    "AvatarHitArea": {
      "type": "object",
      "properties": {
        "hit_area": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "hit_area"
      ]
    },
    "AvatarMeta": {
      "type": "object",
      "properties": {
        "allow_antisocial_or_hate_usage": {
          "type": "boolean",
          "default": false
        },
        "allow_political_or_religious_usage": {
          "type": "boolean",
          "default": false
        },
        "allow_redistribution": {
          "type": "boolean",
          "default": false
        },
        "allow_sexual_usage": {
          "type": "boolean",
          "default": false
        },
        "allow_violent_usage": {
          "type": "boolean",
          "default": false
        },
        "authors": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "avatar_permission": {
          "$ref": "#/$defs/AvatarPermission",
          "default": "only_author"
        },
        "commercial_usage": {
          "$ref": "#/$defs/CommercialUsage",
          "default": "personal_non_profit"
        },
        "contact": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "copyright": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "credit_notation": {
          "$ref": "#/$defs/CreditNotation",
          "default": "required"
        },
        "license_url": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "modification": {
          "$ref": "#/$defs/Modification",
          "default": "prohibited"
        },
        "name": {
          "type": "string",
          "default": ""
        },
        "references": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "third_party_licenses": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "thumbnail": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "AvatarPermission": {
      "oneOf": [
        {
          "type": "string",
          "const": "only_author"
        },
        {
          "type": "string",
          "const": "only_licensed"
        },
        {
          "type": "string",
          "const": "everyone"
        }
      ]
    },
    "AvatarProfile": {
      "type": "object",
      "properties": {
        "hit_areas": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AvatarHitArea"
          }
        },
        "level": {
          "type": "integer",
          "format": "uint8",
          "default": 1,
          "maximum": 255,
          "minimum": 0
        },
        "look_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/LookAt"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "$ref": "#/$defs/AvatarMeta",
          "default": {
            "allow_antisocial_or_hate_usage": false,
            "allow_political_or_religious_usage": false,
            "allow_redistribution": false,
            "allow_sexual_usage": false,
            "allow_violent_usage": false,
            "authors": [],
            "avatar_permission": "only_author",
            "commercial_usage": "personal_non_profit",
            "contact": null,
            "copyright": null,
            "credit_notation": "required",
            "license_url": null,
            "modification": "prohibited",
            "name": "",
            "references": [],
            "third_party_licenses": null,
            "thumbnail": null,
            "version": null
          }
        },
        "profile_version": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "slots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "tracking": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TrackingOverride"
          }
        }
      }
    },
    "BlendMode": {
      "oneOf": [
        {
          "type": "string",
          "const": "normal"
        },
        {
          "type": "string",
          "const": "additive"
        },
        {
          "type": "string",
          "const": "multiply"
        }
      ]
    },
    "Breath": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "array",
          "default": [],
