{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run -q -p ugoe-cli:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo insta:*)",
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm biome:*)",
      "Bash(pnpm --filter @ugoe/editor check)",
      "Bash(pnpm --filter @ugoe/editor build)",
      "Bash(node scripts/tasks.mjs:*)",
      "Bash(node scripts/check-layers.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list)",
      "Bash(git rebase main)",
      "Bash(pnpm install --offline)",
      "Bash(pnpm exec commitlint:*)",
      "Bash(pnpm exec lefthook:*)",
      "Bash(node scripts/worktree.mjs:*)"
    ]
  }
}
